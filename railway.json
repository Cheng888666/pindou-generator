{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "build": {
        "packages": ["python312", "python312Packages.pip"],
        "buildCommand": "cd bead_mosaic && pip install -r requirements.txt"
      }
    }
  },
  "deploy": {
    "startCommand": "cd bead_mosaic && uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/"
  }
}
